{
  "name": "@yuki/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./lib/*": {
      "types": "./dist/lib/*.d.mts",
      "default": "./dist/lib/*.mjs"
    },
    "./components/*": {
      "types": "./dist/components/*.d.mts",
      "default": "./dist/components/*.mjs"
    },
    "./hooks/*": {
      "types": "./dist/hooks/*.d.mts",
      "default": "./dist/hooks/*.mjs"
    },
    "./tailwind.css": "./dist/tailwind.css"
  },
  "scripts": {
    "build": "tsdown",
    "clean": "git clean -xdf .cache dist node_modules",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.2.4",
    "lucide-react": "^1.40.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@types/react": "catalog:react",
    "@yuki/oxlint": "workspace:*",
    "@yuki/tsconfig": "workspace:*",
    "tailwindcss": "catalog:tailwind",
    "tsdown": "catalog:dev",
    "typescript": "catalog:dev"
  },
  "peerDependencies": {
    "next": "catalog:react",
    "react": "catalog:react"
  }
}
