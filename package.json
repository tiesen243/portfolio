{
  "name": "portfolio",
  "private": true,
  "homepage": "https://tiesen.id.vn",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tiesen243/portfolio.git"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build:v2": "turbo run --filter @yuki/web-v2 build",
    "build:v1": "turbo run --filter @yuki/web-v1 build",
    "clean": "turbo run clean && git clean -xdf node_modules",
    "dev": "turbo run --filter @yuki/web-v2 dev --continue",
    "format": "oxfmt --check",
    "format:fix": "oxfmt --write",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "typecheck": "turbo run --filter '*' typecheck"
  },
  "devDependencies": {
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "turbo": "^2.11.3"
  },
  "packageManager": "bun@1.3.0",
  "catalogs": {
    "prod": {
      "@tanstack/react-query": "^5.90.12",
      "zod": "^4.6.5"
    },
    "dev": {
      "@types/node": "^26.6.2",
      "tsdown": "^0.23.0",
      "typescript": "^7.0.2"
    },
    "react": {
      "@types/react": "^19.3.0",
      "@types/react-dom": "^19.3.0",
      "react": "^19.3.0",
      "react-dom": "^19.3.0",
      "next": "^16.3.6"
    },
    "tailwind": {
      "@tailwindcss/postcss": "^4.3.3",
      "@tailwindcss/vite": "^4.2.2",
      "tailwindcss": "^4.3.3"
    }
  }
}
