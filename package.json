{
  "name": "portfolio",
  "private": true,
  "homepage": "https://tiesen.id.vn",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tiesen243/portfolio.git"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build:v2": "turbo run --filter @yuki/web-v2 build",
    "build:v1": "turbo run --filter @yuki/web-v1 build",
    "build": "turbo run build",
    "clean": "turbo run clean && git clean -xdf node_modules",
    "dev": "turbo run --filter @yuki/web-v2 dev --continue",
    "format": "oxfmt --check",
    "format:fix": "oxfmt --write",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "typecheck": "turbo run --filter '*' typecheck"
  },
  "devDependencies": {
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "turbo": "^2.11.10"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.3",
      "onFail": "download"
    }
  },
  "engines": {
    "bun": ">=1.4.0",
    "node": ">=24.20.0"
  },
  "catalogs": {
    "prod": {
      "@tanstack/react-query": "^5.90.12",
      "next-themes": "^0.4.6",
      "zod": "^4.6.7"
    },
    "dev": {
      "@types/mdx": "^2.0.14",
      "@types/node": "^26.6.5",
      "tsdown": "^0.23.1",
      "typescript": "^7.0.2"
    },
    "react": {
      "@types/react": "^19.3.0",
      "@types/react-dom": "^19.3.0",
      "react": "^19.3.1",
      "react-dom": "^19.3.1",
      "next": "^16.4.2"
    },
    "tailwind": {
      "@tailwindcss/postcss": "^4.3.3",
      "@tailwindcss/vite": "^4.2.2",
      "tailwindcss": "^4.3.3"
    },
    "fumadocs": {
      "@fumadocs/base-ui": "^16.17.7",
      "@fumadocs/mdx-remote": "^1.5.2",
      "fumadocs-core": "^16.17.7",
      "fumadocs-mdx": "^15.4.9"
    }
  }
}
